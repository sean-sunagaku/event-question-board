# npm run dev はSites資格情報なしで起動。キーはプロセス内で自動生成。
DB_PATH=work/board.sqlite
# 独立起動するローカルプロセス用。実秘密は追跡しない.env等で管理。
AUTH_MODE=local
NODE_ENV=development
API_ORIGIN=http://127.0.0.1:3002
PUBLIC_ORIGIN=http://127.0.0.1:3000
ADMIN_SUBJECTS=moderator
# PARTICIPANT_KEY と ADMIN_KEY は別々の32文字以上のランダム値。
# 本番はSitesのsecret設定を使用。AUTH_MODE=sites / NODE_ENV=production。

# 自己ホスト本番: サービスごとに別ファイルを使用。実値はGitへ入れない。
# npm run build 後、npm start -- participant|admin|api
# AUTH_MODE=oidc
# PUBLIC_ORIGIN=https://questions.example.com
# API_ORIGIN=https://api.example.com
# OIDC_ISSUER=https://identity.example.com/realms/events
# OIDC_CLIENT_ID=event-question-board-participant
# OIDC_CLIENT_SECRET=replace-with-provider-client-secret
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# SESSION_DB_PATH=/var/lib/event-question-board/participant/sessions.sqlite
# SESSION_TTL_SECONDS=3600
# OIDC_ADMIN_IDENTITIES=[{"issuer":"https://identity.example.com/realms/events","subject":"replace-with-exact-admin-subject"}]
# DB_PATH=/var/lib/event-question-board/api/board.sqlite
# BIND_HOST=127.0.0.1
# PORT=3000
# TLS終端proxyを使う場合（完全一致IPのみ、forwarded-hostは無視）
# TRUSTED_PROXY_IPS=127.0.0.1
# またはNodeでTLSを終端（両方必須、proxy信頼は不要）
# TLS_CERT_FILE=/etc/event-question-board/tls/fullchain.pem
# TLS_KEY_FILE=/etc/event-question-board/tls/privkey.pem
