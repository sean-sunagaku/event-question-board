# npm run dev はSites資格情報なしで起動。キーはプロセス内で自動生成。
DB_PATH=work/board.sqlite
# 独立起動するローカルプロセス用。実秘密は追跡しない.env等で管理。
AUTH_MODE=local
NODE_ENV=development
API_ORIGIN=http://127.0.0.1:3002
PUBLIC_ORIGIN=http://127.0.0.1:3000
ADMIN_SUBJECTS=moderator
# PARTICIPANT_KEY と ADMIN_KEY は別々の32文字以上のランダム値。
# 本番はSitesのsecret設定を使用。AUTH_MODE=sites / NODE_ENV=production。
